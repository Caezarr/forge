# Normalize line endings across macOS, Linux and Vercel builds.
* text=auto

# SQL migrations must stay byte-stable: Drizzle hashes them.
*.sql text eol=lf

# Icons are binary: never diff or convert them.
*.png binary
*.ico binary

# Generated files: collapse them in diffs and keep them out of language stats.
package-lock.json linguist-generated=true -diff
drizzle/meta/*.json linguist-generated=true
